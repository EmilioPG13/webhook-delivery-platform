# Copy to .env and fill in. Never commit .env.
# The dev profile (--spring.profiles.active=dev) ships public throwaway values for all of these.

# Bearer token for /admin/** (the operator console). Empty disables the admin API.
WEBHOOKS_ADMIN_TOKEN=

# Base64 of 32 random bytes; encrypts endpoint secrets at rest. Generate with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
WEBHOOKS_MASTER_KEY=

# PostgreSQL connection (defaults match compose.yaml)
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
